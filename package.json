{
  "name": "picpeak-usage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open, opt-in product usage reporting and feedback for PicPeak",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node scripts/archive-source.js && tsc --noEmit && vite build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "REQUIRE_INTEGRATION=1 node --test --test-concurrency=1 test/integration.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.3",
    "supertest": "^7.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.12"
  }
}
