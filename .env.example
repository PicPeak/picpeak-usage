HOST=127.0.0.1
PORT=3190
DATABASE_PATH=./storage/usage.sqlite
# Optional PostgreSQL, takes precedence over SQLite:
# DATABASE_URL=postgres://usage:change-me@localhost:5432/picpeak_usage
# Private maintainer access only; set 32+ random characters:
MAINTAINER_TOKEN=
# Optional independent 32+ character session derivation key. All replicas must
# use the same value. Defaults to MAINTAINER_TOKEN; no key means voting sessions
# fail closed. Never put this secret in frontend build variables.
SESSION_SECRET=
# Exact trusted proxy hops (0-3), never true. Behind one reverse proxy: 1.
TRUST_PROXY_HOPS=0
