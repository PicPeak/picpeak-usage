HOST=127.0.0.1
PORT=3190
DATABASE_PATH=./storage/usage.sqlite
# Export staging uses anonymous files, removed on close or process exit.
# Default: ./storage (the writable volume in Docker); choose disk, not /tmp's
# small container tmpfs. Per process: two exports, one per reader, 512 MiB each,
# with a 30-second total deadline. Downloads do not retain DB connections.
# EXPORT_TEMP_PATH=./storage
# Optional PostgreSQL, takes precedence over SQLite:
# DATABASE_URL=postgres://usage:change-me@localhost:5432/picpeak_usage
# Private maintainer access only; set 32+ random characters:
MAINTAINER_TOKEN=
# Optional independent 32+ character session derivation key. All replicas must
# use the same value. Defaults to MAINTAINER_TOKEN; no key means voting sessions
# fail closed. Never put this secret in frontend build variables.
SESSION_SECRET=
# Exact trusted proxy hops (0-3), never true. Behind one reverse proxy: 1.
TRUST_PROXY_HOPS=0

# Optional website analytics, separate from opt-in PicPeak product reports.
# Configure these at container startup; no frontend rebuild is needed.
# Requires Umami >= 2.18 (before-send filtering). Both values empty disables it.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Exact hostnames prevent development/preview visits reaching production stats.
UMAMI_DOMAINS=usage.picpeak.app

# Optional confidential weekly email to trusted maintainers. Disabled by default.
WEEKLY_REPORT_ENABLED=false
# Comma-separated plain addresses. Each recipient receives a separate copy.
WEEKLY_REPORT_TO=
WEEKLY_REPORT_BASE_URL=https://usage.picpeak.app
WEEKLY_REPORT_LANGUAGE=en
# Delivery day/time in UTC. Each email covers the preceding Monday–Sunday UTC week.
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_TIME=08:00

# SMTP: starttls (normally port 587), tls (465), or none (trusted local relay only).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
# Leave both empty for a relay without authentication.
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=
SMTP_FROM=
SMTP_FROM_NAME=PicPeak Usage
SMTP_REPLY_TO=
# Optional custom CA PEM and TLS hostname; certificate verification stays enabled.
SMTP_CA_FILE=
SMTP_TLS_SERVERNAME=
SMTP_TIMEOUT_MS=30000
